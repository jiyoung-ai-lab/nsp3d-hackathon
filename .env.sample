# NSP3D local-only settings (copy to .env; never commit the filled file).
# Only analyze.py --llm reads this. Everything else runs keyless.
# The harness searches: explicit --env-file, then .env next to analyze.py, then parents.
# Parent folders are searched too (nearest wins).
# TOKEN_LIMIT aborts analyze.py --llm BEFORE any model call once credit_log.jsonl
# already reached it (sum of total_tokens). 0 = no gate.

# Baseten + Meta (hackathon key; sign up, paste, keep local):
BASETEN_META_HACKATHON_API_KEY=[SECURITY_DATA]

# Optional spend gate for analyze.py --llm (tokens):
TOKEN_LIMIT=0
